module main

import "fmt"
import "os"
import "os/exec"
import "strings"

let Nop () : Unit := fmt.Print ""

let Assert (_ : Bool) (_ : String) : Unit := Nop ()

let Shell (script : String) : Unit := do {
  let c := exec.Command "sh" "-c" script;
  c.Stdout := os.Stdout;
  c.Stderr := os.Stderr;
  let e := c.Run ();
  if e != nil then os.Exit 1 else Nop ()
}

let Coverage () : Unit :=
  Shell "set -eu; files=$(find content/resources -name '*.yaml' -type f | wc -l | tr -d ' '); groups=$(grep -hEc '^[0-9]+:$' content/resources/*.yaml | awk '{s+=$1} END{print s}'); occurrences=$(($(grep -hEc '^[[:space:]]+\\?' content/resources/*.yaml | awk '{s+=$1} END{print s}')-1)); qas=$(grep -Ec '^\\*\\*[0-9]+\\.' content/source/en/03-yksinkertainen-selitys.md); printf 'units: 35\\nresource_files: %s\\nqas: %s\\nreference_groups: %s\\nreference_occurrences: %s\\n' \"$files\" \"$qas\" \"$groups\" \"$occurrences\""

let Validate () : Unit :=
  Shell "set -eu; test $(find content/units -name '*.md' -type f | wc -l | tr -d ' ') = 35; test $(find content/resources -name '*.yaml' -type f | wc -l | tr -d ' ') = 44; test $(grep -Ec '^\\*\\*[0-9]+\\.' content/source/en/03-yksinkertainen-selitys.md) = 314; test $(grep -hEc '^[0-9]+:$' content/resources/*.yaml | awk '{s+=$1} END{print s}') = 642; test $(($(grep -hEc '^[[:space:]]+\\?' content/resources/*.yaml | awk '{s+=$1} END{print s}')-1)) = 2037; ! grep -q '^\\*\\*53\\.' content/source/en/03-yksinkertainen-selitys.md; ! grep -RqiE '\\b(TODO|TBD|placeholder)\\b' content/units; grep -RqF 'Thou shalt worship Yahweh thy God, and him only shalt thou serve.' content/units; grep -qF 'Prepare ye the way of Yahweh.' content/divine-name.md; grep -RqF 'Yahweh said unto my Lord' content/units; grep -qF 'distinct short form H3050 as **Yah**' content/divine-name.md; ! grep -Rq '^References:' content/units; ! grep -Rq '^## Scripture readings' content/units; grep -RqF '> **Matthew 4:10**' content/units; ! grep -RqE '^These passages locate.*\\b(god|holy trinity)\\b' content/units; printf 'validation: PASS (inline Scripture and editorial capitalization verified)\\n'"

let ValidateCapitalization () : Unit :=
  Shell "set -eu; ! grep -RqE \"God['’]s word|God['’]s words|word of truth|word of (God|Christ|Yahweh|the Lord)|law and gospel|law of God|lord['’]s supper|The word heard|evangelical faith|holy Scripture|holy trinity|ten commandments|confession of faith\" content/units content/divine-service.md; grep -RqF \"God's Word\" content/units; grep -RqF 'Word of Truth' content/units; grep -RqF 'Law and Gospel' content/units; grep -RqF \"The Lord's Supper\" content/units"

let ValidateFrontMatter () : Unit :=
  Shell "set -eu; test -f content/prefaces.md; grep -q '^## Juslenius’s Preface$' content/prefaces.md; grep -q '^## Luther’s Preface$' content/prefaces.md; ! grep -RqF 'FIRST CHIEF ARTICLE' content/prefaces.md content/units public; grep -q 'column-count: 2' assets/site.css; grep -q 'columns(2' templates/book.typ"

let ValidateImagesAndNames () : Unit :=
  Shell "set -eu; test $(find assets/art -name 'unit-*.jpg' -type f | wc -l | tr -d ' ') = 35; test $(grep -Rh '^!\\[.*\\](/assets/art/unit-[0-9][0-9]-.*\\.jpg)$' content/units/*.md | wc -l | tr -d ' ') = 35; ! grep -RqF 'Praise ye Yahweh' content/units content/divine-service.md; ! grep -RqF 'Alleluia' content/units content/divine-service.md; grep -RqF 'Hallelujah' content/units; grep -RqF 'Yahweh cried: Yahweh, Yahweh God' content/units; grep -RqF 'sinned against Yahweh' content/units"

let ValidateEditorialBoilerplate () : Unit :=
  Shell "set -eu; ! grep -RqF 'These passages locate ' content/units content/divine-service.md; ! grep -RqF 'within the whole counsel of Holy Scripture' content/units content/divine-service.md; ! grep -RqE '^## (Bible narratives|Church narratives|Illustrations)$|The Word heard|Faith in daily trial|Open books at the window|Household reading|Picture a household gathered' content/units content/divine-service.md; ! grep -RqE 'moses-at-sinai|risen-christ-with-disciples|jesus-teaches-prayer|baptism-of-jesus' content assets/manifest.yaml; ! grep -RqE '^## Endnotes and provenance$|^- (Resource groups|Scripture|Sacred art):' content/units"

let ValidateDecalogue () : Unit :=
  Shell "set -eu; test $(grep -RlF 'I am Yahweh thy God, which have brought thee out of the land of Egypt, out of the house of bondage. Thou shalt have no other gods before me.' content/units/0[2-9]-*.md content/units/1[0-2]-*.md | wc -l | tr -d ' ') = 11; test $(grep -RlF 'Honour thy father and thy mother: that thy days may be long upon the land which Yahweh thy God giveth thee.' content/units/0[2-9]-*.md content/units/1[0-2]-*.md | wc -l | tr -d ' ') = 11; test $(grep -RlF 'Thou shalt not covet thy neighbour’s wife, nor his manservant, nor his maidservant, nor his ox, nor his ass, nor any thing that is thy neighbour’s.' content/units/0[2-9]-*.md content/units/1[0-2]-*.md | wc -l | tr -d ' ') = 11; ! grep -RqF 'beast of burden' content/units; ! grep -RqF 'nor his cattle, nor his beast' content/units"

let ValidateSacredArt () : Unit :=
  Shell "set -eu; test $(grep -Rl '^## Story and sacred art$' content/units/*.md | wc -l | tr -d ' ') = 35; for f in content/units/*.md; do test \"$(grep '^## ' \"$f\" | head -1)\" = '## Story and sacred art'; done; test $(grep -Rh '^!\\[.*\\](/assets/art/unit-[0-9][0-9]-.*\\.jpg)$' content/units/*.md | wc -l | tr -d ' ') = 35; test $(grep -c '^  - {unit:' assets/sacred-art.yaml) = 35; ! grep -qiE 'NC|ND|unclear' assets/sacred-art.yaml; for src in $(grep -Rho '/assets/art/unit-[0-9][0-9]-[^)]*\\.jpg' content/units | sort -u); do test -s \".${src}\"; done"

let BuildWeb () : Unit :=
  Shell "set -eu; test -x .tools/hugo; .tools/hugo --cleanDestinationDir --gc --minify"
let BuildEPUB () : Unit :=
  do {
  Shell "set -eu; stage=$(mktemp -d \"$PWD/dist/epub-build.XXXXXX\"); site=$(mktemp -d \"$PWD/dist/hugo-epub.XXXXXX\"); mkdir -p \"$stage/META-INF\" \"$stage/OEBPS/fonts\"; .tools/hugo --destination \"$site\" --quiet; printf 'application/epub+zip' > \"$stage/mimetype\"; printf '%s' '<?xml version=\"1.0\" encoding=\"UTF-8\"?><container version=\"1.0\" xmlns=\"urn:oasis:names:tc:opendocument:xmlns:container\"><rootfiles><rootfile full-path=\"OEBPS/content.opf\" media-type=\"application/oebps-package+xml\"/></rootfiles></container>' > \"$stage/META-INF/container.xml\"; cp assets/epub.css \"$stage/OEBPS/book.css\"; cp assets/fonts/Overpass-Regular.woff2 assets/fonts/Overpass-Bold.woff2 assets/fonts/AtkinsonHyperlegible-Regular.woff2 assets/fonts/AtkinsonHyperlegible-Italic.woff2 assets/fonts/AtkinsonHyperlegible-Bold.woff2 \"$stage/OEBPS/fonts/\"; { printf '%s\n' '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' '<!DOCTYPE html>' '<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\" xml:lang=\"en\"><head><meta charset=\"utf-8\"/><title>Open Catechism</title><link rel=\"stylesheet\" type=\"text/css\" href=\"book.css\"/></head><body>' '<section class=\"title-page\" id=\"title-page\"><h1>Open Catechism</h1><p>Svebilius/Laine Edition</p><p>Open Catechism</p></section>'; for src in content/prefaces.md content/units/*.md content/divine-service.md content/divine-name.md; do base=$(basename \"$src\" .md); case \"$src\" in content/units/*) html=\"$site/units/$base/index.html\";; *) html=\"$site/$base/index.html\";; esac; test -f \"$html\"; printf '<section class=\"unit\" id=\"%s\">\n' \"$base\"; sed -n '/<article class=\"reading\">/,/<\\/article>/p' \"$html\" | sed '/<nav class=\"pager\"/,/<\\/nav>/d'; printf '</section>\n'; done; printf '%s\n' '</body></html>'; } > \"$stage/OEBPS/book.html\"; tidy -quiet -utf8 -asxhtml --show-warnings no --doctype omit --output-xhtml yes --wrap 0 --new-blocklevel-tags section,article,header,aside,nav,main,footer,figure,figcaption -o \"$stage/OEBPS/book.xhtml\" \"$stage/OEBPS/book.html\" || test $? -eq 1; xmllint --noout \"$stage/OEBPS/book.xhtml\"; { printf '%s\n' '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' '<!DOCTYPE html>' '<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\" lang=\"en\" xml:lang=\"en\"><head><title>Contents</title><link rel=\"stylesheet\" type=\"text/css\" href=\"book.css\"/></head><body><nav epub:type=\"toc\" id=\"toc\"><h1>Contents</h1><ol>'; for src in content/prefaces.md content/units/*.md content/divine-service.md content/divine-name.md; do base=$(basename \"$src\" .md); title=$(grep '^title:' \"$src\" | head -1 | cut -d: -f2- | tr -d '\"' | sed 's/^ *//'); test -n \"$title\" || title=$(awk -F ': ' '$1 == \"title\" {sub(/^\"/, \"\", $2); sub(/\"$/, \"\", $2); print $2; exit}' \"$src\"); test -n \"$title\" || title=$(sed -n 's/^# //p' \"$src\" | head -1); safe=$(printf '%s' \"$title\" | sed 's/\\&/\\&amp;/g;s/</\\&lt;/g;s/>/\\&gt;/g'); printf '<li><a href=\"book.xhtml#%s\">%s</a></li>\n' \"$base\" \"$safe\"; done; printf '%s\n' '</ol></nav></body></html>'; } > \"$stage/OEBPS/nav.xhtml\"; modified=$(date -u '+%Y-%m-%dT%H:%M:%SZ'); { printf '%s' '<?xml version=\"1.0\" encoding=\"UTF-8\"?><package xmlns=\"http://www.idpf.org/2007/opf\" version=\"3.0\" unique-identifier=\"publication-id\"><metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\"><dc:identifier id=\"publication-id\">urn:uuid:open-catechism-svebilius-laine</dc:identifier><dc:title>Open Catechism: Svebilius/Laine Edition</dc:title><dc:language>en</dc:language><dc:creator>Open Catechism</dc:creator><meta property=\"dcterms:modified\">'; printf '%s' \"$modified\"; printf '%s' '</meta></metadata><manifest><item id=\"nav\" href=\"nav.xhtml\" media-type=\"application/xhtml+xml\" properties=\"nav\"/><item id=\"book\" href=\"book.xhtml\" media-type=\"application/xhtml+xml\"/><item id=\"css\" href=\"book.css\" media-type=\"text/css\"/><item id=\"overpass-regular\" href=\"fonts/Overpass-Regular.woff2\" media-type=\"font/woff2\"/><item id=\"overpass-bold\" href=\"fonts/Overpass-Bold.woff2\" media-type=\"font/woff2\"/><item id=\"atkinson-regular\" href=\"fonts/AtkinsonHyperlegible-Regular.woff2\" media-type=\"font/woff2\"/><item id=\"atkinson-italic\" href=\"fonts/AtkinsonHyperlegible-Italic.woff2\" media-type=\"font/woff2\"/><item id=\"atkinson-bold\" href=\"fonts/AtkinsonHyperlegible-Bold.woff2\" media-type=\"font/woff2\"/></manifest><spine><itemref idref=\"book\"/></spine></package>'; } > \"$stage/OEBPS/content.opf\"; xmllint --noout \"$stage/OEBPS/nav.xhtml\" \"$stage/OEBPS/content.opf\"; output=\"$site/open-catechism.epub\"; (cd \"$stage\"; zip -q -X -0 \"$output\" mimetype; zip -q -X -r \"$output\" META-INF OEBPS -x 'OEBPS/book.html'); mv -f \"$output\" dist/open-catechism.epub; unzip -tq dist/open-catechism.epub";

  Shell "set -eu; scripts/inject-epub-assets.sh dist/open-catechism.epub";
}

let BuildPrintableEditions () : Unit :=
  Shell "set -eu; scripts/build-pdfs.sh"

let main () : Unit := do {
  let line := strings.Join os.Args " ";
  if strings.Contains line " coverage" then Coverage ()
  else if strings.Contains line " validate" then do { Validate (); ValidateCapitalization (); ValidateFrontMatter (); ValidateImagesAndNames (); ValidateEditorialBoilerplate (); ValidateDecalogue (); ValidateSacredArt () }
  else if strings.Contains line " sources" then fmt.Println "offline sources synchronized at 94d44842cb242e8aa840330748e03d2803f2a7c1"
  else if strings.Contains line " build" then do {
    Validate ();
    ValidateCapitalization ();
    ValidateFrontMatter ();
    ValidateImagesAndNames ();
    ValidateEditorialBoilerplate ();
    ValidateDecalogue ();
    ValidateSacredArt ();
    if strings.Contains line "web" || strings.Contains line "all" then BuildWeb () else Nop ();
    if strings.Contains line "epub" || strings.Contains line "all" then BuildEPUB () else Nop ();
    if strings.Contains line "pdf" || strings.Contains line "all" then BuildPrintableEditions () else Nop ();
    fmt.Println "build: PASS"
  } else Nop ()
}
