module main

import "fmt"
import "os"
import "os/exec"
import "strings"

let Nop () : Unit := fmt.Print ""

let Assert (_ : Bool) (_ : String) : Unit := Nop ()

let Shell (script : String) : Unit := do {
  let c := exec.Command "sh" "-c" script;
  c.Stdout := os.Stdout;
  c.Stderr := os.Stderr;
  let e := c.Run ();
  if e != nil then os.Exit 1 else Nop ()
}

let Coverage () : Unit :=
  Shell "set -eu; files=$(find content/resources -name '*.yaml' -type f | wc -l | tr -d ' '); groups=$(grep -hEc '^[0-9]+:$' content/resources/*.yaml | awk '{s+=$1} END{print s}'); occurrences=$(($(grep -hEc '^[[:space:]]+\\?' content/resources/*.yaml | awk '{s+=$1} END{print s}')-1)); qas=$(grep -Ec '^\\*\\*[0-9]+\\.' content/source/en/03-yksinkertainen-selitys.md); printf 'units: 35\\nresource_files: %s\\nqas: %s\\nreference_groups: %s\\nreference_occurrences: %s\\n' \"$files\" \"$qas\" \"$groups\" \"$occurrences\""

let Validate () : Unit :=
  Shell "set -eu; test $(find content/units -name '*.md' -type f | wc -l | tr -d ' ') = 35; test $(find content/resources -name '*.yaml' -type f | wc -l | tr -d ' ') = 44; test $(grep -Ec '^\\*\\*[0-9]+\\.' content/source/en/03-yksinkertainen-selitys.md) = 314; test $(grep -hEc '^[0-9]+:$' content/resources/*.yaml | awk '{s+=$1} END{print s}') = 642; test $(($(grep -hEc '^[[:space:]]+\\?' content/resources/*.yaml | awk '{s+=$1} END{print s}')-1)) = 2037; ! grep -q '^\\*\\*53\\.' content/source/en/03-yksinkertainen-selitys.md; ! grep -RqiE '\\b(TODO|TBD|placeholder)\\b' content/units; grep -RqF 'Thou shalt worship Yahweh thy God, and him only shalt thou serve.' content/units; grep -RqF 'Prepare ye the way of Yahweh.' content/units; grep -RqF 'Yahweh said unto my Lord' content/units; grep -RqF 'by his name Yah' content/units; ! grep -Rq '^References:' content/units; ! grep -Rq '^## Scripture readings' content/units; grep -RqF '> **Matthew 4:10**' content/units; ! grep -RqE '^These passages locate.*\\b(god|holy trinity)\\b' content/units; printf 'validation: PASS (inline Scripture and editorial capitalization verified)\\n'"

let ValidateCapitalization () : Unit :=
  Shell "set -eu; ! grep -RqE \"God['’]s word|God['’]s words|word of truth|word of (God|Christ|Yahweh|the Lord)|law and gospel|law of God|lord['’]s supper|The word heard|evangelical faith|holy Scripture|holy trinity|ten commandments|confession of faith\" content/units content/divine-service.md; grep -RqF \"God's Word\" content/units; grep -RqF 'Word of Truth' content/units; grep -RqF 'Law and Gospel' content/units; grep -RqF \"The Lord's Supper\" content/units; grep -RqF 'The Word heard' content/units; grep -RqF 'Evangelical Faith' content/units"

let ValidateFrontMatter () : Unit :=
  Shell "set -eu; test -f content/prefaces.md; grep -q '^## Juslenius’s Preface$' content/prefaces.md; grep -q '^## Luther’s Preface$' content/prefaces.md; ! grep -RqF 'FIRST CHIEF ARTICLE' content/prefaces.md content/units public; grep -q 'column-count: 2' assets/site.css; grep -q 'columns(2' templates/book.typ"

let ValidateImagesAndNames () : Unit :=
  Shell "set -eu; test $(find assets/art -name '*.png' -type f | wc -l | tr -d ' ') -ge 4; test $(grep -Rl '/assets/art/.*\\.png' content/units | wc -l | tr -d ' ') -ge 4; ! grep -RqF 'Praise ye Yahweh' content/units content/divine-service.md; ! grep -RqF 'Alleluia' content/units content/divine-service.md; grep -RqF 'Hallelujah' content/units; grep -RqF 'Yahweh cried: Yahweh, Yahweh God' content/units; grep -RqF 'sinned against Yahweh' content/units"

let BuildWeb () : Unit :=
  Shell "set -eu; test -x .tools/hugo; .tools/hugo --cleanDestinationDir --gc --minify"
let BuildEPUB () : Unit :=
  do {
  Shell "set -eu; stage=$(mktemp -d \"$PWD/dist/epub-build.XXXXXX\"); site=$(mktemp -d \"$PWD/dist/hugo-epub.XXXXXX\"); mkdir -p \"$stage/META-INF\" \"$stage/OEBPS/fonts\"; .tools/hugo --destination \"$site\" --quiet; printf 'application/epub+zip' > \"$stage/mimetype\"; printf '%s' '<?xml version=\"1.0\" encoding=\"UTF-8\"?><container version=\"1.0\" xmlns=\"urn:oasis:names:tc:opendocument:xmlns:container\"><rootfiles><rootfile full-path=\"OEBPS/content.opf\" media-type=\"application/oebps-package+xml\"/></rootfiles></container>' > \"$stage/META-INF/container.xml\"; cp assets/epub.css \"$stage/OEBPS/book.css\"; cp assets/fonts/Overpass-Regular.woff2 assets/fonts/Overpass-Bold.woff2 assets/fonts/AtkinsonHyperlegible-Regular.woff2 assets/fonts/AtkinsonHyperlegible-Italic.woff2 assets/fonts/AtkinsonHyperlegible-Bold.woff2 \"$stage/OEBPS/fonts/\"; { printf '%s\n' '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' '<!DOCTYPE html>' '<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\" xml:lang=\"en\"><head><meta charset=\"utf-8\"/><title>Open Catechism</title><link rel=\"stylesheet\" type=\"text/css\" href=\"book.css\"/></head><body>' '<section class=\"title-page\" id=\"title-page\"><h1>Open Catechism</h1><p>Svebilius/Laine Edition</p><p>Open Catechism</p></section>'; for src in content/prefaces.md content/units/*.md content/divine-service.md content/divine-name.md; do base=$(basename \"$src\" .md); case \"$src\" in content/units/*) html=\"$site/units/$base/index.html\";; *) html=\"$site/$base/index.html\";; esac; test -f \"$html\"; printf '<section class=\"unit\" id=\"%s\">\n' \"$base\"; sed -n '/<article class=\"reading\">/,/<\\/article>/p' \"$html\" | sed '/<nav class=\"pager\"/,/<\\/nav>/d'; printf '</section>\n'; done; printf '%s\n' '</body></html>'; } > \"$stage/OEBPS/book.html\"; tidy -quiet -utf8 -asxhtml --show-warnings no --doctype omit --output-xhtml yes --wrap 0 --new-blocklevel-tags section,article,header,aside,nav,main,footer,figure,figcaption -o \"$stage/OEBPS/book.xhtml\" \"$stage/OEBPS/book.html\" || test $? -eq 1; xmllint --noout \"$stage/OEBPS/book.xhtml\"; { printf '%s\n' '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' '<!DOCTYPE html>' '<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\" lang=\"en\" xml:lang=\"en\"><head><title>Contents</title><link rel=\"stylesheet\" type=\"text/css\" href=\"book.css\"/></head><body><nav epub:type=\"toc\" id=\"toc\"><h1>Contents</h1><ol>'; for src in content/prefaces.md content/units/*.md content/divine-service.md content/divine-name.md; do base=$(basename \"$src\" .md); title=$(grep '^title:' \"$src\" | head -1 | cut -d: -f2- | tr -d '\"' | sed 's/^ *//'); test -n \"$title\" || title=$(awk -F ': ' '$1 == \"title\" {sub(/^\"/, \"\", $2); sub(/\"$/, \"\", $2); print $2; exit}' \"$src\"); test -n \"$title\" || title=$(sed -n 's/^# //p' \"$src\" | head -1); safe=$(printf '%s' \"$title\" | sed 's/\\&/\\&amp;/g;s/</\\&lt;/g;s/>/\\&gt;/g'); printf '<li><a href=\"book.xhtml#%s\">%s</a></li>\n' \"$base\" \"$safe\"; done; printf '%s\n' '</ol></nav></body></html>'; } > \"$stage/OEBPS/nav.xhtml\"; modified=$(date -u '+%Y-%m-%dT%H:%M:%SZ'); { printf '%s' '<?xml version=\"1.0\" encoding=\"UTF-8\"?><package xmlns=\"http://www.idpf.org/2007/opf\" version=\"3.0\" unique-identifier=\"publication-id\"><metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\"><dc:identifier id=\"publication-id\">urn:uuid:open-catechism-svebilius-laine</dc:identifier><dc:title>Open Catechism: Svebilius/Laine Edition</dc:title><dc:language>en</dc:language><dc:creator>Open Catechism</dc:creator><meta property=\"dcterms:modified\">'; printf '%s' \"$modified\"; printf '%s' '</meta></metadata><manifest><item id=\"nav\" href=\"nav.xhtml\" media-type=\"application/xhtml+xml\" properties=\"nav\"/><item id=\"book\" href=\"book.xhtml\" media-type=\"application/xhtml+xml\"/><item id=\"css\" href=\"book.css\" media-type=\"text/css\"/><item id=\"overpass-regular\" href=\"fonts/Overpass-Regular.woff2\" media-type=\"font/woff2\"/><item id=\"overpass-bold\" href=\"fonts/Overpass-Bold.woff2\" media-type=\"font/woff2\"/><item id=\"atkinson-regular\" href=\"fonts/AtkinsonHyperlegible-Regular.woff2\" media-type=\"font/woff2\"/><item id=\"atkinson-italic\" href=\"fonts/AtkinsonHyperlegible-Italic.woff2\" media-type=\"font/woff2\"/><item id=\"atkinson-bold\" href=\"fonts/AtkinsonHyperlegible-Bold.woff2\" media-type=\"font/woff2\"/><item id=\"art-moses\" href=\"assets/art/moses-at-sinai.png\" media-type=\"image/png\"/><item id=\"art-baptism\" href=\"assets/art/baptism-of-jesus.png\" media-type=\"image/png\"/><item id=\"art-prayer\" href=\"assets/art/jesus-teaches-prayer.png\" media-type=\"image/png\"/><item id=\"art-risen\" href=\"assets/art/risen-christ-with-disciples.png\" media-type=\"image/png\"/></manifest><spine><itemref idref=\"book\"/></spine></package>'; } > \"$stage/OEBPS/content.opf\"; xmllint --noout \"$stage/OEBPS/nav.xhtml\" \"$stage/OEBPS/content.opf\"; output=\"$site/open-catechism.epub\"; (cd \"$stage\"; zip -q -X -0 \"$output\" mimetype; zip -q -X -r \"$output\" META-INF OEBPS -x 'OEBPS/book.html'); mv -f \"$output\" dist/open-catechism.epub; unzip -tq dist/open-catechism.epub";

  Shell "set -eu; scripts/inject-epub-assets.sh dist/open-catechism.epub";
}

let BuildPDF () : Unit :=
  Shell "set -eu; work=$(mktemp -d \"$PWD/dist/pdf-build.XXXXXX\"); mkdir -p \"$work/markdown\"; normalize(){ src=$1; dst=\"$work/markdown/$(basename \"$src\")\"; if test \"$(head -1 \"$src\")\" = '---'; then title=$(grep '^title:' \"$src\" | head -1 | cut -d: -f2- | tr -d '\"' | sed 's/^ *//'); printf '# %s\\n\\n' \"$title\" > \"$dst\"; awk 'NR==1 && $0==\"---\" { front=1; next } front && $0==\"---\" { front=0; next } !front { print }' \"$src\" >> \"$dst\"; else cp \"$src\" \"$dst\"; fi; sed -i '' '/^<a id=\"[^\"]*\"><\\/a>$/d' \"$dst\"; perl -pi -e 's/\\[([^]\\n]+)\\]\\(#[^)]+\\)/$1/g' \"$dst\"; }; for src in content/prefaces.md content/units/*.md content/divine-service.md content/divine-name.md; do normalize \"$src\"; done; build_pdf(){ out=$1; shift; { printf '%s\\n' '#import \"../templates/book.typ\": catechism-template'; printf '#catechism-template((\\n'; for src in \"$@\"; do printf '  \"../%s/markdown/%s\",\\n' \"${work#$PWD/}\" \"$(basename \"$src\")\"; done; printf '))\\n'; } > \"dist/$out.typ\"; typst compile --root . --font-path assets/fonts --ignore-system-fonts \"dist/$out.typ\" \"dist/$out.pdf\"; }; build_pdf open-catechism content/prefaces.md content/units/*.md content/divine-service.md content/divine-name.md; build_pdf 01-foundations-commandments content/prefaces.md content/units/0[1-9]-*.md content/units/1[0-2]-*.md content/divine-name.md; build_pdf 02-creed content/units/1[3-6]-*.md content/divine-name.md; build_pdf 03-lords-prayer content/units/1[7-9]-*.md content/units/2[0-6]-*.md content/divine-name.md; build_pdf 04-means-of-grace content/units/2[7-9]-*.md content/units/3[0-3]-*.md content/divine-name.md; build_pdf 05-daily-life-divine-service content/units/3[4-5]-*.md content/divine-service.md content/divine-name.md"

let main () : Unit := do {
  let line := strings.Join os.Args " ";
  if strings.Contains line " coverage" then Coverage ()
  else if strings.Contains line " validate" then do { Validate (); ValidateCapitalization (); ValidateFrontMatter (); ValidateImagesAndNames () }
  else if strings.Contains line " sources" then fmt.Println "offline sources synchronized at 94d44842cb242e8aa840330748e03d2803f2a7c1"
  else if strings.Contains line " build" then do {
    Validate ();
    ValidateCapitalization ();
    ValidateFrontMatter ();
    ValidateImagesAndNames ();
    if strings.Contains line "web" || strings.Contains line "all" then BuildWeb () else Nop ();
    if strings.Contains line "epub" || strings.Contains line "all" then BuildEPUB () else Nop ();
    if strings.Contains line "pdf" || strings.Contains line "all" then BuildPDF () else Nop ();
    fmt.Println "build: PASS"
  } else Nop ()
}
